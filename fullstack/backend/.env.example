# Copiar este archivo como ".env" (en esta misma carpeta) y completar con los datos de tu MySQL.
# El archivo .env no se sube al repositorio porque contiene la contraseña.

# Base de datos MySQL
DB_NAME=instituto_ingles
DB_USER=root
DB_PASSWORD=tu_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Puerto del backend (opcional, por defecto 3000)
PORT=3000
